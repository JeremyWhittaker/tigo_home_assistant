# Dashboard deployment connection details.
#
# The Node.js dashboard tooling deliberately does not auto-load this file.
# Export these names in the invoking shell; see docs/DASHBOARD.md.
HA_BASE_URL=https://home-assistant.example
HA_TOKEN=replace-with-a-home-assistant-admin-token

# Optional token alias. When exported, it takes precedence over HA_TOKEN.
# TIGO_HA_TOKEN=replace-with-a-home-assistant-admin-token

# Optional dashboard/QA settings.
# TIGO_SYSTEM_DEVICE_ID=123456
# HA_TIMEOUT_MS=15000
# CHROMIUM_BIN=/usr/bin/chromium-browser

# Tigo credentials are entered through Home Assistant's integration UI and do
# not belong in this file.
